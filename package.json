    "speculation-rules:headers": "node themes/banyan/scripts/build/emit-speculation-rules-headers.mjs",
    "build": "hugo --gc --cleanDestinationDir --minify && npm run csp:headers && npm run speculation-rules:headers && npm run sync:edgeone",
    "build:browser:temp": "node themes/banyan/scripts/dev/build-browser-temp.mjs",
    "help:browser": "node themes/banyan/scripts/dev/print-browser-help.mjs",
    "check:security:headers": "node themes/banyan/scripts/checks/check-security-headers.mjs",
    "check:public": "node themes/banyan/scripts/checks/check-public-html.mjs",
    "check:public:prod": "node themes/banyan/scripts/checks/check-public-html.mjs public --check",
    "check:browser": "node themes/banyan/scripts/browser-regression/browser.mjs",
    "check:browser:public": "node themes/banyan/scripts/browser-regression/run-entry-with-build.mjs public browser.mjs",
    "check:browser:latest-temp": "node themes/banyan/scripts/browser-regression/run-entry-with-build.mjs latest-temp browser.mjs",
    "check:browser:upgrade": "node themes/banyan/scripts/browser-regression/browser-upgrade.mjs",
    "check:browser:security": "node themes/banyan/scripts/browser-regression/browser-security.mjs",
    "check:browser:speculation": "node themes/banyan/scripts/browser-regression/browser-speculation-rules.mjs",
    "check:browser:speculation:public": "node themes/banyan/scripts/browser-regression/run-entry-with-build.mjs public browser-speculation-rules.mjs",
    "check:browser:speculation:latest-temp": "node themes/banyan/scripts/browser-regression/run-entry-with-build.mjs latest-temp browser-speculation-rules.mjs",
    "check:browser:design": "node themes/banyan/scripts/browser-regression/browser-design-audit.mjs",
    "check:browser:headed": "node themes/banyan/scripts/browser-regression/browser-headed.mjs",
    "check:browser:trace": "node themes/banyan/scripts/browser-regression/browser-trace.mjs",
    "check:browser:install": "npx playwright install chromium",
    "report:assets": "node themes/banyan/scripts/checks/report-assets.mjs",
    "server": "node themes/banyan/scripts/dev/hugo-server-edgeone.mjs",
    "dev": "node themes/banyan/scripts/dev/hugo-server-edgeone.mjs -D"
  },
  "repository": {
    "type": "git",
